# Copy this file to an owner-only location outside the repository and replace
# every CHANGEME value. Point commands at it with ENV_FILE.
# Values are parsed literally: do not add shell quotes or export statements.
AZURE_SUBSCRIPTION_ID=CHANGEME
AZURE_LOCATION=westus2
# Suggested root; choose a distinct root for each new lab.
# The scripts derive AZURE_RESOURCE_GROUP=<root>-infra and ARC_RESOURCE_GROUP=<root>-arc.
RESOURCE_GROUP_ROOT=rg-arc-jumpstart-v2
NAME_PREFIX=jsarc

# Hyper-V host credentials.
HOST_ADMIN_USERNAME=jumpstart
HOST_ADMIN_PASSWORD=CHANGEME

# Fixed, publicly known password for disposable nested Windows guests only.
# Never reuse it for the Azure host, recovery, or SQL service accounts.
NESTED_WINDOWS_PASSWORD=JS123!!

# Used only by Active Directory setup.
SAFE_MODE_PASSWORD=CHANGEME
SQL_SERVICE_ACCOUNT_PASSWORD=CHANGEME

# Shared sa password for all four Database Engines, not SSAS.
# init-config.ps1 generates a unique 52-character password for each new lab.
# Keep it private; do not reuse host, guest, DSRM or SQL service credentials.
# Manual values require 32-128 characters and all four character classes;
# allowed punctuation: !@#$%&*+=?:.,_- (no spaces or quotes).
SQL_SA_PASSWORD=CHANGEME

# Browser access, enabled by default but never a prerequisite for automation.
# Submitted independently after stage 00, without waiting for provisioning.
# Set false to omit it; add it later with ./scripts/deploy.ps1 bastion if needed.
# Without Bastion, interactive access requires private connectivity (VPN/peering);
# Azure VM Run Command remains available.
DEPLOY_BASTION=true

# Installs minimal SSMS 22 on the outer host after the numbered stages finish.
# Stages a signed bootstrapper on the host Public Desktop; does not reboot.
# Set false to omit; recover an existing host with ./scripts/deploy.ps1 ssms.
INSTALL_HOST_SSMS=true

# Explicit setup decision: the agent must ask whether to enable auto-shutdown.
# Use ./scripts/deploy.ps1 auto-shutdown to change this later without replaying
# any infrastructure stage. Time is 24-hour HHmm; the zone is a Windows ID.
AUTO_SHUTDOWN_ENABLED=CHANGEME
AUTO_SHUTDOWN_TIME=2200
AUTO_SHUTDOWN_TIME_ZONE=Central Standard Time

# User-authenticated Azure Arc target. The launcher stage creates this dedicated
# resource group and applies the SQL Developer LicenseOnly deployment tag, but
# only the user can connect the guests with their own Azure identity.
PREPARE_ARC_LAUNCHERS=true
# Leave ARC_LOCATION blank to use AZURE_LOCATION.
ARC_LOCATION=

# Optional sizing overrides.
HOST_VM_SIZE=Standard_E16s_v7
HOST_DATA_DISK_SIZE_GB=1024

# Image source: jumpstart (existing prebuilt disks) or installation-media
# (build local disks from approved official ISOs; no user-hosted blobs).
IMAGE_MODE=installation-media
# Applies to the Azure Marketplace host and the ISO-built nested Windows guests.
# Existing configurations without this setting retain Server 2022 for recovery.
WINDOWS_SERVER_VERSION=2025
# Adds JS-MIGRATE-01: an unused, workgroup Windows VM (8 vCPUs / 16 GiB).
# No appliance, SQL, domain join, or Arc connection is installed on this VM.
INCLUDE_APPLIANCE_VM=true
# Optional Linux inventory guest; false excludes only JS-UBUNTU-01.
INCLUDE_LINUX=true

# Used only by installation-media. The Azure host downloads the official
# English x64 Windows Server 2025 Evaluation ISO, validates Microsoft Setup's
# signature, then records/rechecks its SHA-256 locally. No workstation download.
# auto is allowed ONLY with this exact official source. For custom media,
# supply an approved 64-character SHA-256 instead. No product key is required.
WINDOWS_ISO_URL=https://go.microsoft.com/fwlink/?linkid=2345730&clcid=0x409&culture=en-us&country=us
WINDOWS_ISO_SHA256=auto
UBUNTU_ISO_URL=https://releases.ubuntu.com/22.04.5/ubuntu-22.04.5-live-server-amd64.iso
UBUNTU_ISO_SHA256=9bc6028870aef3f74f4e16b900008179e78b130e6b0b9a140635434a46aa98b0
# Your public key for jumpstart@JS-UBUNTU-01; password login is disabled.
# The host also creates its own restricted key for build verification.
LINUX_SSH_PUBLIC_KEY=CHANGEME

# Used only by jumpstart. Stage 40 generalizes the Windows parent locally.
# Use a Windows-only source; SQL Server is installed after cloning.
IMAGE_SOURCE_URL=https://jumpstartprodsg.blob.core.windows.net/arcbox/prod
# Optional container SAS token for a private image source. Enter the token
# without a leading question mark. Leave blank for public images.
IMAGE_SOURCE_SAS_TOKEN=
WINDOWS_IMAGE_FILE_NAME=ArcBox-Win2K22.vhdx
LINUX_IMAGE_FILE_NAME=ArcBox-Ubuntu-01.vhdx

# Full SQL Server 2025 Enterprise Developer ISO, not the small download bootstrapper.
# Developer is non-production only. Stage 45 accepts Microsoft installer EULAs.
SQL_EDITION_MODE=developer
# Blank derives <root>-media; retained separately when the disposable lab is deleted.
SQL_MEDIA_RESOURCE_GROUP=
# To reference an approved existing account without redeploying its settings,
# also set its explicit resource group above. Existing uploads are verified
# automatically after stage 10; no upload pause when they are already valid.
SQL_MEDIA_ACCOUNT_NAME=
# licensed mode pauses after host creation for private upload of authorized,
# pre-keyed Standard/Enterprise SQL 2025 ISOs; then use deploy.ps1 continue.
SQL_DOWNLOAD_URL=https://download.microsoft.com/download/dea8c210-c44a-4a9d-9d80-0c81578860c5/ENU/SQLServer2025-x64-ENU-EntDev.iso
