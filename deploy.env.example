# Copy this file to an owner-only location outside the repository and replace
# every CHANGEME value. Point commands at it with ENV_FILE.
# Values are parsed literally: do not add shell quotes or export statements.
AZURE_SUBSCRIPTION_ID=CHANGEME
AZURE_LOCATION=westus2
AZURE_RESOURCE_GROUP=rg-arc-jumpstart-v2
NAME_PREFIX=jsarc

# Hyper-V host credentials.
HOST_ADMIN_USERNAME=jumpstart
HOST_ADMIN_PASSWORD=CHANGEME

# Credentials for the prebuilt nested Windows VHDX images.
# The current Microsoft Jumpstart images use Administrator / JS123!!.
NESTED_WINDOWS_PASSWORD=CHANGEME

# Used only by Active Directory setup.
SAFE_MODE_PASSWORD=CHANGEME
SQL_SERVICE_ACCOUNT_PASSWORD=CHANGEME

# Browser access, enabled by default but never a prerequisite for automation.
# Submitted independently after stage 00, without waiting for provisioning.
# Set false to omit it; add it later with ./scripts/deploy.sh bastion if needed.
# Without Bastion, interactive access requires private connectivity (VPN/peering);
# Azure VM Run Command remains available.
DEPLOY_BASTION=true

# Explicit setup decision: the agent must ask whether to enable auto-shutdown.
# Use ./scripts/deploy.sh auto-shutdown to change this later without replaying
# any infrastructure stage. Time is 24-hour HHmm; the zone is a Windows ID.
AUTO_SHUTDOWN_ENABLED=CHANGEME
AUTO_SHUTDOWN_TIME=2200
AUTO_SHUTDOWN_TIME_ZONE=Central Standard Time

# Learner-facing Azure Arc target. The launcher stage creates this dedicated
# resource group and applies the SQL Developer LicenseOnly deployment tag.
PREPARE_ARC_LAUNCHERS=true
# Leave blank to derive <AZURE_RESOURCE_GROUP>-arc and use AZURE_LOCATION.
ARC_RESOURCE_GROUP=
ARC_LOCATION=

# Optional sizing overrides.
HOST_VM_SIZE=Standard_E16s_v7
HOST_DATA_DISK_SIZE_GB=1024

# Optional image overrides. Stage 40 generalizes the Windows parent locally.
# Use a Windows-only source; SQL Server is installed after cloning.
IMAGE_SOURCE_URL=https://jumpstartprodsg.blob.core.windows.net/arcbox/prod
# Optional container SAS token for a private image source. Enter the token
# without a leading question mark. Leave blank for public images.
IMAGE_SOURCE_SAS_TOKEN=
WINDOWS_IMAGE_FILE_NAME=ArcBox-Win2K22.vhdx
LINUX_IMAGE_FILE_NAME=ArcBox-Ubuntu-01.vhdx

# Full SQL Server 2025 Enterprise Developer ISO, not the small download bootstrapper.
# Developer is non-production only. Stage 45 accepts Microsoft installer EULAs.
SQL_DOWNLOAD_URL=https://download.microsoft.com/download/dea8c210-c44a-4a9d-9d80-0c81578860c5/ENU/SQLServer2025-x64-ENU-EntDev.iso
